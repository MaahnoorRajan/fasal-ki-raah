# Set these in the hosting service environment. This file is not loaded by Django.
FASAL_DEBUG=0
FASAL_SECRET_KEY=
FASAL_ALLOWED_HOSTS=your-domain.example
FASAL_CSRF_ORIGINS=https://your-domain.example
FASAL_DATABASE_PATH=/data/db.sqlite3
# Enable only behind an HTTPS proxy that replaces forwarded headers.
FASAL_TRUST_PROXY=1
# Use the proxy address as seen by Waitress. The loopback value suits a native host.
FASAL_PROXY_IP=127.0.0.1
PORT=8000
